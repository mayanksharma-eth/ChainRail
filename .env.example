# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
#
# Everything here overrides config/*.toml. The prefix is CHAINRAIL__ and the
# nesting separator is a double underscore.

# local | test | ci | staging | production
# Anything other than local/test/ci enables production guard rails: a real
# signer backend, an API token, TLS-only RPC, and JSON logging all become
# mandatory, and the process refuses to boot without them.
APP_ENV=local

# ---------------------------------------------------------------- datastores
# Host ports match docker-compose defaults, chosen high to avoid colliding with
# a local Postgres or another project's stack.
CHAINRAIL__DATABASE__URL=postgres://chainrail:chainrail@127.0.0.1:55432/chainrail
CHAINRAIL__REDIS__URL=redis://127.0.0.1:56379
CHAINRAIL__KAFKA__BROKERS=127.0.0.1:19092

# Recommended least-privilege setup for a real deployment: the application role
# gets DML only, and owns nothing.
#
#   CREATE ROLE chainrail_app LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE chainrail TO chainrail_app;
#   GRANT USAGE ON SCHEMA public TO chainrail_app;
#   GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA public TO chainrail_app;
#   -- deliberately NOT granted: DELETE, TRUNCATE, DROP, ALTER.
#   -- Ledger tables are append-only by trigger; withholding DELETE means even a
#   -- SQL-injection bug cannot erase financial history.
# Migrations run as a separate owner role, not as the application role.

# ------------------------------------------------------------------- signer
# DEVELOPMENT ONLY. Hardhat account #0: a published, worthless key used by every
# EVM test suite. Fine against a testnet; catastrophic anywhere else.
#
# Production would replace this with AWS KMS, Vault Transit, an HSM, or an MPC
# custody provider -- none of which ChainRail implements. The signer trait is the
# seam for that change. See docs/threat-model.md#key-custody.
CHAINRAIL__SIGNER__BACKEND=local_development
CHAINRAIL__SIGNER__PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --------------------------------------------------------------------- auth
# Required outside local/test/ci. A single shared bearer token is a placeholder
# for a real authentication service; it carries no user identity or scopes.
# CHAINRAIL__HTTP__API_TOKEN=generate-a-long-random-value

# ------------------------------------------------------------------- rpc
# Public endpoints are rate-limited and often stale. Point these at a paid
# provider for anything beyond local experimentation, and give the paid endpoint
# a higher weight so it is preferred while the public one remains as failover.
# CHAINRAIL__CHAINS__0__RPC__0__URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# ---------------------------------------------------------- observability
CHAINRAIL__OBSERVABILITY__LOG_LEVEL=info
CHAINRAIL__OBSERVABILITY__LOG_FORMAT=pretty
# CHAINRAIL__OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4317

# --------------------------------------------------------------- testing
# A SEPARATE database. The integration harness TRUNCATEs every table between
# tests, so pointing this at the application database would wipe a running
# worker's state mid-run. docker-compose creates `chainrail_test` on first init.
#
# Integration tests skip themselves when this is unset, so `cargo test --all`
# works without Docker.
TEST_DATABASE_URL=postgres://chainrail:chainrail@127.0.0.1:55432/chainrail_test

# ------------------------------------------------- docker-compose host ports
# Override if the defaults clash on your machine.
# POSTGRES_PORT=55432
# REDIS_PORT=56379
# REDPANDA_PORT=19092
# API_PORT=8088
# API_METRICS_PORT=9090
# WORKER_METRICS_PORT=9091
# PROMETHEUS_PORT=9095
# GRAFANA_PORT=3001
